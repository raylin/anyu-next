# Local server env mirror names only. Do not commit real values.
# Staging QA scripts load apps/web/.env.staging by default when shell env is absent.
# Production local preflight mode uses apps/web/.env.production.
# Precedence is exported shell env > local mirror file.
# Future pnpm ops CLI must not load apps/web env mirror files.
OPERATOR_TEST_SECRET=
INTERNAL_JOB_SECRET=
QA_FAKE_PAID_PROCESSOR_MODE=
QA_FAKE_PAID_INPUT_SUFFIX=
QA_NEWEBPAY_BASE_URL=
QA_NEWEBPAY_INPUT_SUFFIX=
QA_NEWEBPAY_STATE_FILE=
QA_NO_CARD_BASE_URL=
QA_NO_CARD_DISABLE_LOCAL_ENV=
QA_NO_CARD_INPUT_SUFFIX=
QA_NO_CARD_PROCESSOR_MODE=
