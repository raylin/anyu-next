{
  "functions": {
    "src/app/api/internal/queues/paid-generation/route.ts": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "paid-generation-jobs",
          "retryAfterSeconds": 60
        }
      ]
    }
  },
  "crons": [
    {
      "path": "/api/cron/retention-cleanup",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/cron/paid-generation",
      "schedule": "30 17 * * *"
    }
  ]
}
